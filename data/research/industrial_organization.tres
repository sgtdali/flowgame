[gd_resource type="Resource" script_class="ResearchNode" format=3]

[ext_resource type="Script" path="res://data/research_node.gd" id="1_research"]

[resource]
script = ExtResource("1_research")
id = &"industrial_organization"
display_name = "Industrial Organization"
description = "Organize connected Extractors, Smelting Hearths, and Electric Rolling Mills into an Ironworks Complex. A complex preserves the existing machines and lets you opt into shared material and power infrastructure."
requires = PackedStringArray("presleme")
# MVP: Electrified Rolling tamamlandığında kompleks araçları ek para kapısı
# olmadan alınabilir. Tasarım belgesi bu teknoloji için maliyet tanımlamadı;
# ayrı bir 2.500-altın eşiği, mevcut ekonomide erişilemez bir kilit yaratıyordu.
cost_money = 0
unlocks_complexes = true
