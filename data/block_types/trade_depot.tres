[resource]
script = ExtResource("1_htaww")
id = &"trade_depot"
display_name = "Trade Depot"
category = 3
accent_color = Color(0.5, 0.42, 0.62, 1)
icon_char = "TD"
description = "Holds one sellable good and waits — the moment it arrives, Demand from a Trade Network starts accumulating, and the good sells the instant 100 Demand is reached. Has no pace of its own — its throughput is a direct function of Trade Network's speed, so a faster network always helps."
