[gd_resource type="Resource" script_class="FactoryGate" format=3]

[ext_resource type="Script" path="res://data/factory_gate.gd" id="1_gate"]

[resource]
script = ExtResource("1_gate")
direction = 1
name_format = "Output: %s"
id = &"gate_out"
display_name = "Output gate"
category = 5
accent_color = Color(0.3, 0.45, 0.62, 1)
description = "Puts goods into the factory's output stock; routes leaving the factory take from there."
input_capacity = 4
output_capacity = 0
unlocked_at_start = true
